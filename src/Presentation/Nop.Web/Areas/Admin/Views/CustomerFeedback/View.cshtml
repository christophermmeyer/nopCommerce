@model CustomerFeedbackModel

@{
    ViewBag.PageTitle = T("Admin.Customers.CustomerFeedback.ViewDetails").Text;
    NopHtml.SetActiveMenuItemSystemName("Customer feedback");
}

<form asp-controller="CustomerFeedback" asp-action="View" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Customers.CustomerFeedback.ViewDetails")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">@T("Admin.Customers.CustomerFeedback.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            @if (!Model.IsRead)
            {
                <button type="submit" asp-action="MarkAsRead" asp-route-id="@Model.Id" class="btn btn-success">
                    <i class="far fa-envelope-open"></i>
                    @T("Admin.Customers.CustomerFeedback.MarkAsRead")
                </button>
            }
            <span id="customer-feedback-delete" class="btn btn-danger">
                <i class="far fa-trash-can"></i>
                @T("Admin.Common.Delete")
            </span>
            @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.CustomerFeedbackDetailsButtons, additionalData = Model })
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default">
                        <div asp-validation-summary="All"></div>
                        <div class="card-body">
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="CreatedOn" />
                                </div>
                                <div class="col-md-9">
                                    <div class="form-text-row">@Model.CreatedOn</div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="StoreName" />
                                </div>
                                <div class="col-md-9">
                                    <div class="form-text-row">@Model.StoreName</div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="CustomerId" />
                                </div>
                                <div class="col-md-9">
                                    @if (Model.CustomerId > 0)
                                    {
                                        <a asp-controller="Customer" asp-action="Edit" asp-route-id="@Model.CustomerId">@(!string.IsNullOrEmpty(Model.CustomerEmail) ? Model.CustomerEmail : T("Admin.Customers.Guest").Text)</a>
                                    }
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="FullName" />
                                </div>
                                <div class="col-md-9">
                                    <div class="form-text-row">@Model.FullName</div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="Email" />
                                </div>
                                <div class="col-md-9">
                                    <div class="form-text-row">@Model.Email</div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="SubjectName" />
                                </div>
                                <div class="col-md-9">
                                    <div class="form-text-row">@Model.SubjectName</div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="Rating" />
                                </div>
                                <div class="col-md-9">
                                    <div class="form-text-row">@Model.Rating / 5</div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="IsRead" />
                                </div>
                                <div class="col-md-9">
                                    <div class="form-text-row">@(Model.IsRead ? T("Admin.Common.Yes") : T("Admin.Common.No"))</div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="FeedbackText" />
                                </div>
                                <div class="col-md-9">
                                    <div class="form-text-row">@Model.FeedbackText</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="customer-feedback-delete" />
